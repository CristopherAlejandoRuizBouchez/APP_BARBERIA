# ══════════════════════════════════════════════════════════════════════════
#  BARBERÍA OS — Variables de entorno de la PLATAFORMA
#
#  Copia este archivo a .env.local y llena al menos las claves de Supabase.
#  .env.local está en .gitignore y NUNCA debe subirse al repositorio.
#
#  ─────────────────────────────────────────────────────────────────────────
#  IMPORTANTE: aquí NO va la configuración de ninguna barbería.
#
#  El nombre, la ciudad, el WhatsApp, los colores y la plantilla de cada
#  negocio viven en Supabase (organizations, locations, organization_themes)
#  y se resuelven por petición según el slug de la URL. Un mismo despliegue
#  sirve a varias barberías, y una variable no puede tener dos valores.
#  ─────────────────────────────────────────────────────────────────────────
#
#  Las banderas aceptan EXACTAMENTE "true" o "false". Cualquier otro texto
#  detiene el arranque: en JavaScript Boolean("false") vale true, y una
#  coerción descuidada encendería en producción algo que creías apagado.
#
#  Si lleva el prefijo NEXT_PUBLIC_, acaba en el navegador de cualquiera.
#  Si un valor es secreto, no lleva ese prefijo. Jamás.
# ══════════════════════════════════════════════════════════════════════════


# ─── PLATAFORMA ────────────────────────────────────────────── obligatoria ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_NAME=Barbería OS

# Dominio base para los futuros subdominios barberia.barberiaos.com.
# Con NEXT_PUBLIC_FLAG_CUSTOM_DOMAINS=false solo se usan rutas /b/<slug>.
NEXT_PUBLIC_BASE_DOMAIN=localhost

NEXT_PUBLIC_LOCALE=es-MX
NEXT_PUBLIC_MONEDA=MXN

# Solo el valor inicial de una SUCURSAL NUEVA. Cada `locations` guarda el
# suyo, porque Sonora y Quintana Roo no van en el horario del centro.
NEXT_PUBLIC_ZONA_HORARIA_POR_DEFECTO=America/Mexico_City


# ─── SUPABASE ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública actual recomendada por Supabase. Es segura en el navegador
# cuando todas las tablas tienen RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad con proyectos antiguos. Puede dejarse vacía si se usa la
# clave publicable anterior.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠ SOLO SERVIDOR. Ignora todas las políticas de RLS.
#   En Vercel debe marcarse como "Sensitive".
#   Si algún día ves esta clave con el prefijo NEXT_PUBLIC_, es una brecha.
SUPABASE_SERVICE_ROLE_KEY=

# Solo para migraciones locales y CI. NO se carga en Vercel: vive en los
# secretos del repositorio de GitHub.
SUPABASE_DATABASE_URL=
SUPABASE_PROJECT_ID=


# ─── OPERACIÓN DE LA PLATAFORMA ────────────────────────────────────────────
# Correo del primer superadministrador. Se da de alta a mano con la clave de
# servicio; no existe registro público de superadministradores.
PLATFORM_SUPERADMIN_EMAIL=

# WhatsApp de soporte que se muestra a una barbería con adeudo.
# Formato canónico: "52" + 10 dígitos, sin "+" y sin el "1" antiguo.
PLATFORM_SUPPORT_WHATSAPP=

# Protege las rutas /api/cron/*. Genera con: openssl rand -base64 32
CRON_SECRET=

# Secreto compartido entre pg_cron y la Edge Function de WhatsApp.
# Se guarda en Supabase Vault, NUNCA dentro de una migración.
EDGE_SHARED_SECRET=


# ─── WHATSAPP CLOUD API ─────────────────────────────────────── opcional ──
# Mientras estén vacías y la bandera apagada, los recordatorios se generan
# igual y quedan en la bandeja de envío manual del panel de cada barbería.
# El WhatsApp de cada negocio NO está aquí: está en su ficha de organización.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0


# ─── BANDERAS DE PLATAFORMA ────────────────────────────────────────────────
# Valores admitidos: "true" o "false", exactamente. Nada más.
# Estas ponen el TECHO: si una está apagada, ninguna barbería puede
# encenderla desde su propio panel.

# WhatsApp Cloud API. Apagada: se usan enlaces wa.me, sin costo.
NEXT_PUBLIC_FLAG_WHATSAPP_CLOUD=false

# Pagos en línea de los clientes a la barbería. Fuera de alcance en v1.
NEXT_PUBLIC_FLAG_ONLINE_CUSTOMER_PAYMENTS=false

# Subdominios y dominios propios por barbería. Apagada: solo /b/<slug>.
NEXT_PUBLIC_FLAG_CUSTOM_DOMAINS=false

# Alta automática de barberías. Apagada: el superadministrador crea la
# barbería e invita al propietario con un enlace seguro.
NEXT_PUBLIC_FLAG_PUBLIC_SIGNUP=false

# Modo mantenimiento de toda la plataforma.
NEXT_PUBLIC_FLAG_MAINTENANCE=false


# ─── OPCIONALES ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
